  1393                              <1> ; 32-BYTE MOCK FILE SYSTEM DATA
  1394                              <1> ; [0-12]  : Filename string (13 bytes max, null terminated)
  1395                              <1> ; [13]    : Attribute (00h = Normal File, 10h = Directory)
  1396                              <1> ; [14-17] : File Size (DWORD - 4 bytes)
  1397                              <1> ; [18-19] : MS-DOS Date Word (Bits: YYYYYYY MMMMDDDDD)
  1398                              <1> ; [20-21] : MS-DOS Time Word (Bits: HHHHHMMMMMMSSSSS)
  1399                              <1> ; [22-31] : Reserved Padding (10 bytes)
  1400                              <1> ; -------------------------------------------------------------------
