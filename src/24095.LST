  1271                              <1> ; 32-BYTE MOCK FILE SYSTEM DATA
  1272                              <1> ; [0-12]  : Filename string (13 bytes max, null terminated)
  1273                              <1> ; [13]    : Attribute (00h = Normal File, 10h = Directory)
  1274                              <1> ; [14-17] : File Size (DWORD - 4 bytes)
  1275                              <1> ; [18-19] : MS-DOS Date Word (Bits: YYYYYYY MMMMDDDDD)
  1276                              <1> ; [20-21] : MS-DOS Time Word (Bits: HHHHHMMMMMMSSSSS)
  1277                              <1> ; [22-31] : Reserved Padding (10 bytes)
  1278                              <1> ; -------------------------------------------------------------------
  1279                              <1> 
